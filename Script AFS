-- Minimizar lógica
local minimized = false
local originalSize = fundo.Size
local originalButtonsVisible = {}

minimizarBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		fundo.Size = UDim2.new(0, 420, 0, 60)
		for _, child in pairs(fundo:GetChildren()) do
			if child:IsA("TextButton") or (child:IsA("Frame") and child.Name ~= "TituloBar") then
				originalButtonsVisible[child] = child.Visible
				child.Visible = false
			end
		end
	else
		fundo.Size = originalSize
		for child, wasVisible in pairs(originalButtonsVisible) do
			if child and child.Parent == fundo then
				child.Visible = wasVisible
			end
		end
	end
end)

