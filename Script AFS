-- Ativar Coordenadas
local coordBtn = criarBotao("CoordBtn", "Ativar Coordenadas", 132)
local coordAtivo = false

-- Painel de coordenadas arrastável reutilizando seu código
local function criarCoordenadasScreenGui()
	if _G.CoordenadasScreenGui then
		_G.CoordenadasScreenGui.Enabled = true
		return
	end

	local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
	gui.Name = "PosicaoGUI"
	_G.CoordenadasScreenGui = gui

	local botao = Instance.new("TextButton")
	botao.Size = UDim2.new(0, 200, 0, 50)
	botao.Position = UDim2.new(0, 20, 0, 20)
	botao.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	botao.TextColor3 = Color3.fromRGB(255, 255, 255)
	botao.TextScaled = true
	botao.Font = Enum.Font.SourceSansBold
	botao.Text = "Carregando..."
	botao.Parent = gui

	-- Botão de fechar
	local fechar = Instance.new("TextButton")
	fechar.Size = UDim2.new(0, 32, 0, 32)
	fechar.Position = UDim2.new(1, -36, 0, 4)
	fechar.BackgroundColor3 = Color3.fromRGB(50, 0, 100)
	fechar.TextColor3 = Color3.fromRGB(255, 255, 255)
	fechar.Text = "X"
	fechar.TextSize = 20
	fechar.Font = Enum.Font.GothamBlack
	fechar.Parent = botao
	fechar.ZIndex = 2
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1,0)
	fc.Parent = fechar

	fechar.MouseButton1Click:Connect(function()
		gui.Enabled = false
		coordBtn.Text = "Ativar Coordenadas"
		coordAtivo = false
	end)

	-- Drag funcionalidade
	local UserInputService = game:GetService("UserInputService")
	local dragging = false
	local dragInput, dragStart, startPos

	botao.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = botao.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	botao.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			botao.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	-- Atualiza a posição a cada 0.2s
	spawn(function()
		while gui and gui.Enabled do
			wait(0.2)
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local pos = player.Character.HumanoidRootPart.Position
				local x = math.floor(pos.X)
				local y = math.floor(pos.Y)
				local z = math.floor(pos.Z)
				botao.Text = "X = "..x..", Y = "..y..", Z = "..z
			end
		end
	end)
end

coordBtn.MouseButton1Click:Connect(function()
	if not coordAtivo then
		criarCoordenadasScreenGui()
		coordBtn.Text = "Desativar Coordenadas"
		coordAtivo = true
	else
		if _G.CoordenadasScreenGui then
			_G.CoordenadasScreenGui.Enabled = false
		end
		coordBtn.Text = "Ativar Coordenadas"
		coordAtivo = false
	end
end)

-- FLY
local ativarFlyBtn = criarBotao("AtivarFlyBtn", "Ativar Fly", 190)
local desativarFlyBtn = criarBotao("DesativarFlyBtn", "Desativar Fly", 248)
local flying = false
local moveDirection = Vector3.new()
local flySpeed = 150
local bodyVelocity
local uis = game:GetService("UserInputService")
local directions = {
    [Enum.KeyCode.W] = Vector3.new(0, 0, -1),
    [Enum.KeyCode.S] = Vector3.new(0, 0, 1),
    [Enum.KeyCode.A] = Vector3.new(-1, 0, 0),
    [Enum.KeyCode.D] = Vector3.new(1, 0, 0)
}

uis.InputBegan:Connect(function(input, gameProcessed)
    if flying and directions[input.KeyCode] then
        moveDirection += directions[input.KeyCode]
    end
end)
uis.InputEnded:Connect(function(input)
    if flying and directions[input.KeyCode] then
        moveDirection -= directions[input.KeyCode]
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if flying and bodyVelocity and hrp then
        bodyVelocity.Velocity = Vector3.new(0, 3, 0)
        if moveDirection.Magnitude > 0 then
            local cam = workspace.CurrentCamera
            local dir = cam.CFrame:VectorToWorldSpace(moveDirection).Unit
            hrp.CFrame = hrp.CFrame + dir * flySpeed * 0.016
        end
    end
end)

ativarFlyBtn.MouseButton1Click:Connect(function()
    if not flying and hrp then
        flying = true
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 3, 0)
        bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
        bodyVelocity.Parent = hrp
        ativarFlyBtn.Text = "Voando!"
        desativarFlyBtn.Text = "Desativar Fly"
    end
end)
desativarFlyBtn.MouseButton1Click:Connect(function()
    if flying then
        flying = false
        moveDirection = Vector3.new()
        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end
        ativarFlyBtn.Text = "Ativar Fly"
        desativarFlyBtn.Text = "Desativar Fly"
    end
end)

-- VELOCIDADE
local velocidadeUpBtn = criarBotao("VelocidadeUpBtn", "Dobrar VELOCIDADE", 306)
local velocidadeDownBtn = criarBotao("VelocidadeDownBtn", "Diminuir VELOCIDADE", 364)
local minSpeed = 4
local maxSpeed = 200

velocidadeUpBtn.MouseButton1Click:Connect(function()
    local newSpeed = humanoid.WalkSpeed * 2
    if newSpeed > maxSpeed then newSpeed = maxSpeed end
    humanoid.WalkSpeed = newSpeed
    velocidadeUpBtn.Text = "Velocidade: "..newSpeed
    wait(1)
    velocidadeUpBtn.Text = "Dobrar VELOCIDADE"
end)

velocidadeDownBtn.MouseButton1Click:Connect(function()
    local newSpeed = humanoid.WalkSpeed / 2
    if newSpeed < minSpeed then newSpeed = minSpeed end
    humanoid.WalkSpeed = newSpeed
    velocidadeDownBtn.Text = "Velocidade: "..newSpeed
    wait(1)
    velocidadeDownBtn.Text = "Diminuir VELOCIDADE"
end)
